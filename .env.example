# Rede Acolher — exemplo de configuração (SEM segredos reais)
# Copie para .env e ajuste. Nunca faça commit do .env.

# Banco de dados
DATABASE_URL=postgres://rede_admin:dev-only-change-me@localhost:5432/rede_acolher
# Papel de aplicação (não superusuário) usado em tempo de execução — criado pela migração 001
DATABASE_APP_URL=postgres://rede_app:dev-only-change-me-app@localhost:5432/rede_acolher

# Sessões
SESSION_TTL_HOURS=14           # cobre um plantão 12x36 com margem
SESSION_PEPPER=troque-este-valor-em-producao

# A JANELA DE ACESSO POR PLANTÃO (T-10/T+10, §5.12) NÃO EXISTE AINDA.
#
# `SHIFT_WINDOW_MODE` e `SHIFT_WINDOW_TOLERANCE_MIN` estavam aqui, e nenhuma
# linha de código as lia. Uma chave que não faz nada é pior do que chave
# nenhuma: alguém escreve `enforce`, acredita que a casa está protegida, e
# ninguém descobre o contrário até o dia em que precisar do bloqueio.
#
# Ela depende da ESCALA 12x36 vigente, que a Fundação ainda não entregou — sem
# saber quem está de plantão, "fora da escala" não é uma frase com sentido.
# Está na §11 do `docs/REDE-ACOLHER.md`, item 2, e é uma das perguntas ao
# Marcelo. (Até 09/09 este comentário mandava ler o `docs/o-que-falta.md`, que
# foi para `docs/historico/` na consolidação: remissão a documento aposentado
# ensina a não confiar no arquivo inteiro, que é o defeito que ele mesmo
# descreve logo acima.)

# O horário das ATAs NÃO é variável de ambiente desde a fase 157: a Fundação
# decidiu em 25/09 (diurna 08:00–20:00, noturna 20:01–07:59), e a regra mora no
# banco (identity/1573) com o espelho em backend/src/kernel/common/tempo.ts.
# Uma variável aqui deixaria o servidor discordar do banco sem ninguém saber.

# Proteção contra força bruta
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Servidor
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# O QUE O SISTEMA GUARDA FORA DO BANCO
#
# São DOIS lugares diferentes, e o backup precisa dos dois. Perder um deles é
# perder documento de criança sem que o banco acuse nada — ele continua
# dizendo que o arquivo existe.
# ---------------------------------------------------------------------------

# Objetos do dossiê do acolhido: certidão, foto, laudo, comprovante.
ARQUIVOS_DIR=./.arquivos
# Cópias documentais arquivadas (o "Drive" da Fundação; local no piloto).
ARQUIVO_DRIVE_DIR=/var/lib/rede-acolher/arquivo
# `falha` derruba o envio de propósito — existe para o teste, nunca em produção.
ARQUIVO_MODO=

# Timbre da Fundação nos documentos gerados (PNG).
TIMBRE_PATH=./assets/timbre.png

# ---------------------------------------------------------------------------
# A CHAVE DO COFRE
#
# Cifra as credenciais de acesso dos acolhidos (gov.br, INSS, CTPS, banco).
# Sem ela o cofre não abre — nem para quem tem a senha e a autorização. Ela
# NÃO é senha de usuário: aquela é hash irreversível e não passa por aqui.
#
# Duas coisas que decidem se um backup vale alguma coisa:
#  * backup do banco SEM esta chave devolve bytes ilegíveis. O cofre morre com
#    a chave, não com o servidor;
#  * esta chave guardada JUNTO do backup deixa o cofre aberto para quem
#    encontrar a cópia. Ela vive em outro lugar, com outro dono.
# ---------------------------------------------------------------------------
CREDENTIAL_KEY=troque-este-valor-em-producao-e-guarde-fora-do-backup

# Convite de primeiro acesso
APP_BASE_URL=http://localhost:5173
# 24 HORAS — que é o que o código faz sem esta chave, com o motivo escrito ao
# lado dele ("convite parado é porta aberta"), e o que a §7 do REDE-ACOLHER.md
# afirma como invariante.
#
# Este arquivo dizia 72 desde a fase do backup, sem motivo em lugar nenhum. Nada
# quebrava: quem copia o exemplo — que é a instrução do §12.1 — implantava três
# dias de porta aberta acreditando estar em um, e o conferidor de implantação
# cobra que a chave EXISTA, não que ela diga a mesma coisa que o código.
#
# Alongar é decisão da Fundação (§11, item 13): com quarenta pessoas convidadas
# na implantação, 24 horas pode ser curto. Se mudar, muda AQUI e na §7.
CONVITE_HORAS=24
# `arquivo` grava o e-mail em disco em vez de enviar — é o modo do piloto,
# enquanto o SMTP institucional não existe (ver §12.8 do docs/REDE-ACOLHER.md).
EMAIL_MODO=arquivo
EMAIL_DIR=./.emails

# Enfermagem — prazo esperado de triagem (pendência institucional 33.4.2)
NURSING_TRIAGE_SLA_HOURS=24

# O relógio (§12.7): em nome de quem rodam as rotinas do dia — doses geradas da
# prescrição, atividades da rotina, escalonamento do que atrasou, aniversários.
# Tudo o que ele gerar fica na auditoria com este nome, então NÃO use a conta de
# uma pessoa. Sem esta variável, `npm run relogio` não roda e diz por quê.
RELOGIO_USER_EMAIL=relogio@paodospobres.dev
